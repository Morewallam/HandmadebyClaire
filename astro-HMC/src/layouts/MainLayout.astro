---
import "../styles/global.css";
const { title, description, image } = Astro.props;
import { Font } from "astro:assets";
import { urlFor } from "../helper/imageUrlHelper";
---

<style is:inline>
  html,
  body {
    overscroll-behavior-y: none;
  }
</style>
<html lang="en" class="bg-green-900/90">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>

    <meta property="og:title" content={title} />
    {
      image && (
        <meta property="og:image" content={urlFor(image).width(300).url()} />
      )
    }
    <meta name="description" content={description} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <Font cssVariable="--font-tempus" preload />
  </head>
  <body class="font-seriff bg-olive-200">
    <header
      class="sticky top-0 z-50 bg-green-900/90 backdrop-blur-sm border-b border-green-800 h-15 flex items-center justify-between pl-10 pr-5"
    >
      <a
        href="/"
        class="font-tempus text-xl tracking-wide text-white hover:text-stone-100 transition-colors"
      >
        Handmade By Claire
      </a>

      <!-- Desktop nav -->
      <nav
        class="hidden md:flex gap-6 text-sm tracking-widest uppercase text-white"
      >
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <a href="/works" class="hover:text-white transition-colors">Browse</a>
        <a href="/workshops" class="hover:text-white transition-colors"
          >Workshops</a
        >
        <a href="/about" class="hover:text-white transition-colors">About</a>

        <a href="#Contact" class="hover:text-white transition-colors">Contact</a
        >
      </nav>

      <!-- Mobile hamburger button -->
      <button
        id="menu-toggle"
        aria-label="Toggle menu"
        aria-expanded="false"
        class="md:hidden text-white p-2 -mr-2"
      >
        <svg
          id="icon-open"
          xmlns="http://www.w3.org/2000/svg"
          class="w-6 h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="icon-close"
          xmlns="http://www.w3.org/2000/svg"
          class="w-6 h-6 hidden"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </header>

    <!-- Mobile dropdown panel -->
    <div
      id="mobile-menu"
      class="hidden md:hidden fixed top-15 left-0 right-0 z-40 bg-green-900/95 backdrop-blur-sm border-b border-green-800 flex flex-col text-white text-sm tracking-widest uppercase"
    >
      <a href="/" class="px-10 py-4 hover:bg-green-800 transition-colors"
        >Home</a
      >
      <a href="/works" class="px-10 py-4 hover:bg-green-800 transition-colors"
        >Browse</a
      >
      <a
        href="/workshops"
        class="px-10 py-4 hover:bg-green-800 transition-colors">Workshops</a
      >
      <a href="/about" class="px-10 py-4 hover:bg-green-800 transition-colors"
        >About</a
      >

      <a href="#Contact" class="px-10 py-4 hover:bg-green-800 transition-colors"
        >Contact</a
      >
    </div>

    <slot />

    <footer class="w-full bg-taupe-800 text-taupe-100 pt-12 pb-6 px-10">
      <div
        class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-10 pb-10 border-b border-taupe-600"
      >
        <!-- Brand -->
        <div class="flex flex-col gap-3">
          <span class="font-tempus text-2xl tracking-wide"
            >Handmade By Claire</span
          >
          <p class="text-sm text-taupe-300 leading-relaxed">
            Original Textile Art
          </p>
        </div>

        <!-- Navigation -->
        <div class="flex flex-col gap-2">
          <span class="text-xs uppercase tracking-widest text-taupe-400 mb-1"
            >Explore</span
          >
          <a href="/" class="text-sm hover:text-white transition-colors">Home</a
          >
          <a href="/works" class="text-sm hover:text-white transition-colors"
            >Browse Works</a
          >
          <a href="/#Events" class="text-sm hover:text-white transition-colors"
            >Events</a
          >
          <a href="/#Stores" class="text-sm hover:text-white transition-colors"
            >Stores</a
          >
          <a
            href="/workshops"
            class="text-sm hover:text-white transition-colors">Workshops</a
          >
          <a href="/about" class="text-sm hover:text-white transition-colors"
            >About</a
          >
        </div>

        <!-- Contact & Social -->
        <div id="Contact" class="flex flex-col gap-2">
          <span class="text-xs uppercase tracking-widest text-taupe-400 mb-1"
            >Get in Touch</span
          >
          <a
            href="mailto:handmadebyclairestationary@gmail.com"
            class="text-sm hover:text-white transition-colors"
          >
            handmadebyclairestationary@gmail.com
          </a>
          <a
            href="tel:+16042228507"
            class="text-sm hover:text-white transition-colors"
          >
            604&#8209;222&#8209;8507
          </a>
          <div class="flex flex-col gap-4 mt-2">
            <!-- Instagram -->
            <a
              href="https://www.instagram.com/handmadebyclairestationery/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-taupe-300 hover:text-white transition-colors"
            >
              <div class="flex">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <rect
                    x="2"
                    y="2"
                    width="20"
                    height="20"
                    rx="5"
                    ry="5"
                    stroke-width="1.5"></rect>
                  <circle cx="12" cy="12" r="4" stroke-width="1.5"></circle>
                  <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"
                  ></circle>
                </svg>
                <span class="text-sm pl-1">@handmadebyclairestationary</span>
              </div>
            </a>

            <!-- Facebook -->
            <a
              href="https://www.facebook.com/HandmadebyClaireStationery "
              target="_blank"
              rel="noopener noreferrer"
              class="text-taupe-300 hover:text-white transition-colors"
            >
              <div class="flex">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M20 1C21.6569 1 23 2.34315 23 4V20C23 21.6569 21.6569 23 20 23H4C2.34315 23 1 21.6569 1 20V4C1 2.34315 2.34315 1 4 1H20ZM20 3C20.5523 3 21 3.44772 21 4V20C21 20.5523 20.5523 21 20 21H15V13.9999H17.0762C17.5066 13.9999 17.8887 13.7245 18.0249 13.3161L18.4679 11.9871C18.6298 11.5014 18.2683 10.9999 17.7564 10.9999H15V8.99992C15 8.49992 15.5 7.99992 16 7.99992H18C18.5523 7.99992 19 7.5522 19 6.99992V6.31393C19 5.99091 18.7937 5.7013 18.4813 5.61887C17.1705 5.27295 16 5.27295 16 5.27295C13.5 5.27295 12 6.99992 12 8.49992V10.9999H10C9.44772 10.9999 9 11.4476 9 11.9999V12.9999C9 13.5522 9.44771 13.9999 10 13.9999H12V21H4C3.44772 21 3 20.5523 3 20V4C3 3.44772 3.44772 3 4 3H20Z"
                    fill="currentColor"></path>
                </svg>
                <span class="text-sm pl-1">Handmade by Claire</span>
              </div>
            </a>
          </div>
        </div>

        <div
          class="max-w-5xl mx-auto pt-6 text-center text-xs text-taupe-400 tracking-wide"
        >
          © {new Date().getFullYear()} Handmade By Claire. All rights reserved.
        </div>
        <div class="pt-6 text-center text-xs text-taupe-400 tracking-wide">
          Website designed and developed by Sean Wallace. <a
            href="mailto:swallace987@gmail.com"
            ><u class="text-nowrap">Contact me</u></a
          >
        </div>
      </div>
    </footer>

    <script is:inline>
      const toggle = document.getElementById("menu-toggle");
      const menu = document.getElementById("mobile-menu");
      const iconOpen = document.getElementById("icon-open");
      const iconClose = document.getElementById("icon-close");

      toggle?.addEventListener("click", () => {
        const isOpen = menu?.classList.contains("hidden") === false;

        menu?.classList.toggle("hidden");
        iconOpen?.classList.toggle("hidden");
        iconClose?.classList.toggle("hidden");
        toggle.setAttribute("aria-expanded", String(!isOpen));
      });

      // Close menu when a link inside it is clicked
      menu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          menu.classList.add("hidden");
          iconOpen?.classList.remove("hidden");
          iconClose?.classList.add("hidden");
          toggle?.setAttribute("aria-expanded", "false");
        });
      });
    </script>
  </body>
</html>
