---
import { sanityClient } from "sanity:client";
import Description from "../components/Description.astro";
import ImageRender from "../components/ImageRender.astro";
import HorizontalScroll from "../components/HorizontalScroll.astro";
import ScrollCard from "../components/ScrollCard.astro";
import type { PortableTextBlock } from "sanity";
import type { SanityImageSource } from "@sanity/image-url";
import MainLayout from "../layouts/MainLayout.astro";

const WORKSHOP_PAGE_QUERY = `*[
  _type == "workshoppage"][0]{
    _id, 
    workshop_description,
    images[]
    }`;
const workshop_page_info = await sanityClient.fetch<{
  _id: string;
  workshop_description: PortableTextBlock;
  images?: SanityImageSource[];
}>(WORKSHOP_PAGE_QUERY);
---

<MainLayout title="Handmade By Claire">
  <div
    id="Workshops"
    class="w-full flex flex-col items-center pt-6 pb-14 px-6 md:px-0"
  >
    <h2
      class="text-6xl pt-8 text-center w-full font-tempus tracking-wide text-taupe-700"
    >
      Workshops
      <div class="mx-auto mt-2 mb-5 w-60 h-[2px] bg-taupe-700 rounded-full">
      </div>
    </h2>

    <div class="w-full min-w-0 relative">
      <div
        class="absolute left-0 top-0 bottom-0 w-12 bg-gradient-to-r from-olive-200 to-transparent z-10 pointer-events-none"
      >
      </div>
      <div
        class="absolute right-0 top-0 bottom-0 w-12 bg-gradient-to-l from-olive-200 to-transparent z-10 pointer-events-none"
      >
      </div>
      {
        workshop_page_info.images && (
          <HorizontalScroll center={true}>
            {workshop_page_info.images.map((img) => (
              <ScrollCard>
                <div class="w-72 group">
                  <div class="overflow-hidden rounded-md shadow-md ">
                    <ImageRender
                      alt="workshop images"
                      image={img}
                      width={500}
                      style="w-full h-64 object-cover rounded-md"
                    />
                  </div>
                </div>
              </ScrollCard>
            ))}
          </HorizontalScroll>
        )
      }
    </div>

    <div
      class="max-w-3xl w-full text-lg text-taupe-800 text-center [&_p]:leading-relaxed [&_p]:mb-4 mt-8"
    >
      <Description description={workshop_page_info.workshop_description} />
    </div>
  </div>
</MainLayout>
