---
import "../../../styles/global.css";
import { sanityClient } from "sanity:client";
import MainLayout from "../../../layouts/MainLayout.astro";
import Selection, { type Page } from "../../../components/Selection.astro";

const PRODUCT_QUERY = `*[_type == "category" && slug.current==$cat][0] {
  _id,
  title,
  slug,
  image,
  "products": *[_type == "product" && references(^._id) && defined(slug.current)]
  |order(order asc){
    _id,
    order, 
    "name":IndividualProductName,
    slug,
    "mainImage":MainImage,
    "category":Category-> {
        title,
        slug
    },
    "size":Size[]->{
        title,
        slug
    },
    "theme":Theme->{
        title,
        slug
    },
    "occasion":Occasion[]->{
        title,
        slug
    },
    "description":Description,
    }
}`;

const categoryItems = await sanityClient.fetch<Page>(
  PRODUCT_QUERY,
  Astro.params,
);

type paths = Promise<{ params: { cat: string } }[]>;

export async function getStaticPaths(): paths {
  const SLUGS_QUERY = `*[_type == "category" && defined(slug.current)]{
    "params": {"cat": slug.current}
    }`;
  return await sanityClient.fetch(SLUGS_QUERY);
}
---

<MainLayout
  title={categoryItems.title}
  description=`View ${categoryItems.title} category items`
  image={categoryItems.image}
>
  <Selection page={categoryItems} />
</MainLayout>
