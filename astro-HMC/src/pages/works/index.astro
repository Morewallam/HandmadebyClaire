---
import "../../styles/global.css";
import type { SanityDocument } from "@sanity/client";

import type { SanityImageObject } from "@sanity/image-url";
import { sanityClient } from "sanity:client";
import ImageRender from "../../components/ImageRender.astro";
import Description from "../../components/Description.astro";
import ArtProduct from "../../components/ArtProduct.astro";
import HorizontalScroll from "../../components/HorizontalScroll.astro";
import ScrollCard from "../../components/ScrollCard.astro";
import ThemeCard from "../../components/ThemeCard.astro";
import MainLayout from "../../layouts/MainLayout.astro";

const CATEGORY_QUERY = `*[
 _type == "category" && defined(slug.current)
]{
 _id,
 title,
 slug,
 image,
 "products": *[_type == "product" && references(^._id) && defined(slug.current)]{
 _id,
 slug
 }
}[count(products) > 0] `;

const THEME_QUERY = `*[
 _type == "theme" && defined(slug.current)
]{
 _id,
 title,
 slug,
 image,
 "products": *[_type == "product" && references(^._id) && defined(slug.current)]{
 _id,
 slug
 }
}[count(products) > 0] `;

const OCCASION_QUERY = `*[
 _type == "occasion" && defined(slug.current)
]{
 _id,
 title,
 slug,
 image,
 "products": *[_type == "product" && references(^._id) && defined(slug.current)]{
 _id,
 slug
 }
}[count(products) > 0] `;

const PRODUCT_QUERY = `*[_type == "category" && defined(slug.current)] {
  _id,
  title,
  slug,
  image,
  "products": *[_type == "product" && references(^._id) && defined(slug.current)]
  {
    _id, 
    IndividualProductName,
    slug,
    MainImage,
    Category,
    Category-> {
        title,
        slug
    },
    Size[]->{
        title,
        slug
    },
    Theme->{
        title,
        slug
    },
    Occasion[]->{
        title,
        slug
    },
    Description,
    publishedAt
    }
}[count(products) > 0]`;

const products_by_theme =
  await sanityClient.fetch<SanityDocument[]>(PRODUCT_QUERY);

const categories = await sanityClient.fetch<SanityDocument[]>(CATEGORY_QUERY);

const themes = await sanityClient.fetch<SanityDocument[]>(THEME_QUERY);

const occasions = await sanityClient.fetch<SanityDocument[]>(OCCASION_QUERY);
---

<MainLayout>
  <div class="bg-olive-200">
    <div class="mx-auto p-6 sm:p-8">
      <!-- <h1
