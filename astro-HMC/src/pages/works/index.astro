---
import "../../styles/global.css";
import type { SanityDocument } from "@sanity/client";

import { sanityClient } from "sanity:client";
import HorizontalScroll from "../../components/HorizontalScroll.astro";
import ScrollCard from "../../components/ScrollCard.astro";
import ThemeCard from "../../components/ThemeCard.astro";
import MainLayout from "../../layouts/MainLayout.astro";

const CATEGORY_QUERY = `*[
 _type == "category" && defined(slug.current)
]{
 _id,
 title,
 slug,
 image,
 order,
 "products": *[_type == "product" && references(^._id) && defined(slug.current)]{
 _id,
 slug
 }
}[count(products) > 0] | order(order asc)`;

const THEME_QUERY = `*[
 _type == "theme" && defined(slug.current)
]{
 _id,
 title,
 slug,
 image,
 order,
 "products": *[_type == "product" && references(^._id) && defined(slug.current)]{
 _id,
 slug
 }
}[count(products) > 0] | order(order asc) `;

const categories = await sanityClient.fetch<SanityDocument[]>(CATEGORY_QUERY);

const themes = await sanityClient.fetch<SanityDocument[]>(THEME_QUERY);
---

<MainLayout
  title="Browse"
  description="Browse the different themes and categories of art."
>
  <div class="bg-olive-200">
    <div class="mx-auto pt-6 pb-6 sm:pt-8 sm:pb-8">
      <h2 class="font-medium text-3xl text-center">Categories</h2>
      <div class="relative">
        <div
          class="absolute left-0 top-0 bottom-0 w-4 lg:w-8 bg-gradient-to-r from-olive-200 to-transparent z-10 pointer-events-none"
        >
        </div>
        <div
          class="absolute right-0 top-0 bottom-0 w-4 lg:w-8 bg-gradient-to-l from-olive-200 to-transparent z-10 pointer-events-none"
        >
        </div>
        <HorizontalScroll>
          {
            categories.map((cat) => (
              <ScrollCard>
                <ThemeCard
                  image={cat.image}
                  slug={cat.slug}
                  name={cat.title}
                  type="category"
                  size="large"
                />
              </ScrollCard>
            ))
          }
        </HorizontalScroll>
      </div>
      <div>
        <h2 class="pb-8 font-medium text-3xl text-center">Themes</h2>

        <div class="flex flex-wrap justify-center gap-5">
          {
            themes.map((cat) => (
              <ThemeCard
                image={cat.image}
                slug={cat.slug}
                name={cat.title}
                type="theme"
                size="large"
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</MainLayout>
