---
import "../../../styles/global.css";
import { sanityClient } from "sanity:client";
import MainLayout from "../../../layouts/MainLayout.astro";
import Selection, { type Page } from "../../../components/Selection.astro";

const PRODUCT_QUERY = `*[_type == "theme" && slug.current==$theme][0] {
  _id,
  title,
  slug,
  image,
  "products": *[_type == "product" && references(^._id) && defined(slug.current)]
  |order(order asc){
    _id, 
    IndividualProductName,
    slug,
    MainImage,
    order,
    Category-> {
        title,
        slug
    },
    Size[]->{
        title,
        slug
    },
    Theme->{
        title,
        slug
    },
    Occasion[]->{
        title,
        slug
    },
    Description,
    publishedAt
    }
}`;

const themeItems = await sanityClient.fetch<Page>(PRODUCT_QUERY, Astro.params);

type paths = Promise<{ params: { theme: string } }[]>;

export async function getStaticPaths(): paths {
  const SLUGS_QUERY = `*[_type == "theme" && defined(slug.current)]{
    "params": {"theme": slug.current}
    }`;
  return await sanityClient.fetch(SLUGS_QUERY);
}

let m = [1];
m.length;
---

<MainLayout title={themeItems.title}>
  <Selection page={themeItems} />
</MainLayout>
