---
import "../../../styles/global.css";
import { sanityClient } from "sanity:client";
import MainLayout from "../../../layouts/MainLayout.astro";
import Selection, { type Page } from "../../../components/Selection.astro";

const PRODUCT_QUERY = `*[_type == "size" && slug.current==$size][0] {
  _id,
  title,
  slug,
  image,
  "products": *[_type == "product" && references(^._id) && defined(slug.current)]
  |order(publishedAt asc){
    _id, 
    IndividualProductName,
    slug,
    MainImage,
    Category-> {
        title,
        slug
    },
    Size[]->{
        title,
        slug
    },
    Theme->{
        title,
        slug
    },
    Occasion[]->{
        title,
        slug
    },
    Description,
    publishedAt
    }
}`;

const sizeItems = await sanityClient.fetch<Page>(PRODUCT_QUERY, Astro.params);

type paths = Promise<{ params: { size: string } }[]>;

export async function getStaticPaths(): paths {
  const SLUGS_QUERY = `*[_type == "size" && defined(slug.current)]{
    "params": {"size": slug.current}
    }`;
  return await sanityClient.fetch(SLUGS_QUERY);
}
---

<MainLayout title={sizeItems.title}>
  <Selection page={sizeItems} />
</MainLayout>
