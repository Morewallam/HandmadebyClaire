---
import "../../../styles/global.css";
import { sanityClient } from "sanity:client";
import MainLayout from "../../../layouts/MainLayout.astro";
import Selection, { type Page } from "../../../components/Selection.astro";

const PRODUCT_QUERY = `*[_type == "occasion" && slug.current==$occ][0] {
  _id,
  title,
  slug,
  image,
  "products": *[_type == "product" && references(^._id) && defined(slug.current)]
  |order(publishedAt asc){
    _id, 
    IndividualProductName,
    slug,
    MainImage,
    Category-> {
        title,
        slug
    },
    Size[]->{
        title,
        slug
    },
    Theme->{
        title,
        slug
    },
    Occasion[]->{
        title,
        slug
    },
    Description,
    publishedAt
    }
}`;

const categoryItems = await sanityClient.fetch<Page>(
  PRODUCT_QUERY,
  Astro.params,
);

type paths = Promise<{ params: { occ: string } }[]>;

export async function getStaticPaths(): paths {
  const SLUGS_QUERY = `*[_type == "occasion" && defined(slug.current)]{
    "params": {"occ": slug.current}
    }`;
  return await sanityClient.fetch(SLUGS_QUERY);
}
---

<MainLayout title={categoryItems.title}>
  <Selection page={categoryItems} />
</MainLayout>
