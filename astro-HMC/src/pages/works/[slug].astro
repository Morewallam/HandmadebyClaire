---
import "../../styles/global.css";
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";
import { PortableText } from "astro-portabletext";
import ArtProduct from "../../components/ArtProduct.astro";
import ImageRender from "../../components/ImageRender.astro";
import Description from "../../components/Description.astro";
import { urlFor } from "../../helper/imageUrlHelper";
import HorizontalScroll from "../../components/HorizontalScroll.astro";
import ScrollCard from "../../components/ScrollCard.astro";
import MainLayout from "../../layouts/MainLayout.astro";

const POST_QUERY = `*[
  _type == "product"
  && slug.current == $slug][0]{
    _id, 
    IndividualProductName,
    slug,
    MainImage,
    SubImage,
    Category->{
        title,
        slug
    },
    Size[]->{
        title,
        slug
    },
    Theme->{
        title,
        slug
    },
    Occasion[]->{
        title,
        slug
    },
    Description,
    publishedAt
    }`;

const post = await sanityClient.fetch<SanityDocument>(POST_QUERY, Astro.params);

type paths = Promise<{ params: { slug: string } }[]>;

let combinedSizes = "";
post.Size.map((s: any, i: int) => {
  if (i < post.Size.length - 1) {
    combinedSizes += s.title + ", ";
  } else {
    combinedSizes += s.title;
  }
});

let combinedOccassions = "";
if (post.Occasion) {
  post.Occasion.map((s: any, i: int) => {
    if (i < post.Occasion.length - 1) {
      combinedOccassions += s.title + ", ";
    } else {
      combinedOccassions += s.title;
    }
  });
}

export async function getStaticPaths(): paths {
  const SLUGS_QUERY = `*[_type == "product" && defined(slug.current)]{
    "params": {"slug": slug.current}
    }`;
  return await sanityClient.fetch(SLUGS_QUERY);
}
---

<MainLayout>
  <div class="bg-olive-50 text-gray-900">
    <div class="max-w-5xl mx-auto px-6 py-10">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <div class="flex flex-col gap-5">
          <div>
            <h1 class="text-3xl font-bold text-gray-900 mb-2">
              {post.IndividualProductName}
            </h1>
            <div>
              <span class="text-gray-500 text-lg">{post.Category.title}</span>
            </div>
            <div>
              <span class="text-gray-500">
                {combinedSizes}
              </span>
            </div>
          </div>

          <!-- Description -->
          <p class="text-gray-600 text-sm leading-relaxed">
            <Description description={post.Description} />
          </p>

          <div>
            {
              combinedOccassions && (
                <span class="text-gray-500">
                  Occasion: {combinedOccassions}
                </span>
              )
            }
          </div>
        </div>

        <div class="flex flex-col gap-4">
          <div
            class="w-105 h-120 rounded-xl flex items-center justify-center overflow-hidden"
          >
            <img
              src={urlFor(post.MainImage).height(500).url()}
              alt={post.alt}
              class="w-full h-full rounded-xl object-contain drop-shadow-lg/30 p-5"
              id="main-img"
            />
          </div>

          <!-- Thumbnails -->
          <!-- <div class="rounded-lg shadow-m bg-gray-100 w-105 p-3"> -->
          {
            post.SubImage && (
              <HorizontalScroll gap="" padding="">
                <ScrollCard padding="p-1">
                  <button
                    data-thumb={urlFor(post.MainImage).height(500).url()}
                    class:list={[
                      "thumb border-2 border-indigo-500 rounded-lg overflow-hidden w-24 h-24 flex-shrink-0 transition-transform duration-300 hover:scale-105 hover:cursor-pointer shadow",
                    ]}
                  >
                    <img
                      src={urlFor(post.MainImage).height(100).url()}
                      alt={post.alt}
                      class="w-full h-full object-contain"
                    />
                  </button>
                </ScrollCard>

                {post.SubImage.map((image: any) => (
                  <ScrollCard padding="p-1">
                    <button
                      data-thumb={urlFor(image).height(500).url()}
                      class:list={[
                        "thumb border-2 rounded-lg overflow-hidden w-24 h-24 flex-shrink-0 transition-colors",
                        "border-transparent transition-transform duration-300 hover:scale-105 hover:cursor-pointer shadow",
                      ]}
                    >
                      <img
                        src={urlFor(image).height(100).url()}
                        alt={image.alt}
                        class="w-full h-full object-contain"
                      />
                    </button>
                  </ScrollCard>
                ))}
              </HorizontalScroll>
            )
          }
        </div>

        <script>
          // Thumbnail switcher
          const mainImg = document.getElementById(
            "main-img",
          ) as unknown as ImageRenderProps;
          document
            .querySelectorAll<HTMLButtonElement>(".thumb")
            .forEach((btn) => {
              btn.addEventListener("click", () => {
                const src = btn.dataset.thumb!;
                mainImg.src = src;
                document.querySelectorAll(".thumb").forEach((t) => {
                  t.classList.remove("border-indigo-500");
                  t.classList.add("border-transparent");
                });
                btn.classList.remove("border-transparent");
                btn.classList.add("border-indigo-500");
              });
            });
        </script>
      </div>
    </div>
  </div>
</MainLayout>
