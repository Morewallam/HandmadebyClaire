---
import "../../styles/global.css";
import { sanityClient } from "sanity:client";
import Description from "../../components/Description.astro";
import { urlFor } from "../../helper/imageUrlHelper";
import HorizontalScroll from "../../components/HorizontalScroll.astro";
import ScrollCard from "../../components/ScrollCard.astro";
import MainLayout from "../../layouts/MainLayout.astro";
import type { SanityImageSource } from "@sanity/image-url";
import type { PortableTextBlock, Slug } from "sanity";
import type { HalfProduct } from "../../components/ArtProduct.astro";
import { toPlainText } from "../../helper/plainTextPortable";
import ImageRender from "../../components/ImageRender.astro";

export interface Product extends HalfProduct {
  subImages?: SanityImageSource[];
  occasion?: { title: string; slug: Slug }[];
  description: PortableTextBlock;
  size: { title: string; slug: Slug }[];
}

const PRODUCT_QUERY = `*[
  _type == "product"
  && slug.current == $slug][0]{
    _id, 
    "name":IndividualProductName,
    slug,
    "mainImage":MainImage,
    "subImages":SubImage[],
    "category":Category->{
        title,
        slug
    },
    "size":Size[]->{
        title,
        slug
    },
    "theme":Theme->{
        title,
        slug
    },
    "occasion":Occasion[]->{
        title,
        slug
    },
    "description":Description
    }`;

const product = await sanityClient.fetch<Product>(PRODUCT_QUERY, Astro.params);

type paths = Promise<{ params: { slug: string } }[]>;

let combinedSizes = "";
product.size.map((s, i: number) => {
  if (i < product.size.length - 1) {
    combinedSizes += s.title + ", ";
  } else {
    combinedSizes += s.title;
  }
});

let combinedOccassions = "";
if (product.occasion) {
  const len = product.occasion.length;
  product.occasion.map((occasion, i: number) => {
    if (i < len - 1) {
      combinedOccassions += occasion.title + ", ";
    } else {
      combinedOccassions += occasion.title;
    }
  });
}

export async function getStaticPaths(): paths {
  const SLUGS_QUERY = `*[_type == "product" && defined(slug.current)]{
    "params": {"slug": slug.current}
    }`;
  return await sanityClient.fetch(SLUGS_QUERY);
}
---

<MainLayout
  title={product.name}
  description={toPlainText(product.description)}
  image={product.mainImage}
>
  <div class="bg-olive-50 text-gray-900">
    <div class="max-w-5xl mx-auto px-6 py-10">
      <div class="grid grid-cols-1 md:grid-cols-3 items-center gap-2 md:gap-12">
        <div class="flex flex-col items gap-5">
          <div>
            <h1 class="text-3xl font-bold text-gray-900 mb-2">
              {product.name}
            </h1>
            <div>
              <span class="text-gray-500 text-lg">{product.category.title}</span
              >
            </div>
            <div>
              <span class="text-gray-500">
                {combinedSizes}
              </span>
            </div>
          </div>

          <p class="text-gray-600 text-sm leading-relaxed">
            <Description description={product.description} />
          </p>

          <div>
            {
              combinedOccassions && (
                <span class="text-gray-500">
                  Occasion: {combinedOccassions}
                </span>
              )
            }
          </div>
        </div>

        <div class="flex flex-col items-center gap-4 md:col-span-2">
          <div
            class="w-full h-80 sm:h-100 md:h-120 rounded-xl flex overflow-hidden"
          >
            <img
              src={urlFor(product.mainImage).width(500).auto("format").url()}
              srcset={[
                `${urlFor(product.mainImage).width(200).auto("format").url()} 200w`,
                `${urlFor(product.mainImage).width(400).auto("format").url()} 400w`,
                `${urlFor(product.mainImage).width(800).auto("format").url()} 800w`,
                `${urlFor(product.mainImage).width(1200).auto("format").url()} 1200w`,
              ].join(", ")}
              sizes="auto"
              alt={product.name}
              class="w-full h-full rounded-xl object-contain drop-shadow-lg/30 p-2"
              id="main-img"
            />
          </div>

          {
            product.subImages && (
              <HorizontalScroll gap="" padding="" center={true}>
                <ScrollCard padding="p-1">
                  <button
                    data-src={urlFor(product.mainImage)
                      .width(500)
                      .auto("format")
                      .url()}
                    data-srcset={[
                      `${urlFor(product.mainImage).width(200).auto("format").url()} 200w`,
                      `${urlFor(product.mainImage).width(400).auto("format").url()} 400w`,
                      `${urlFor(product.mainImage).width(800).auto("format").url()} 800w`,
                      `${urlFor(product.mainImage).width(1200).auto("format").url()} 1200w`,
                    ].join(", ")}
                    class:list={[
                      "thumb border-2 border-indigo-500 rounded-lg overflow-hidden w-32 h-32 flex-shrink-0 transition-transform duration-300 hover:scale-105 hover:cursor-pointer shadow",
                    ]}
                  >
                    <img
                      src={urlFor(product.mainImage)
                        .height(100)
                        .auto("format")
                        .url()}
                      srcset={[
                        `${urlFor(product.mainImage).width(100).auto("format").url()} 100w`,
                        `${urlFor(product.mainImage).width(200).auto("format").url()} 200w`,
                        `${urlFor(product.mainImage).width(400).auto("format").url()} 400w`,
                      ].join(", ")}
                      sizes="auto"
                      loading="lazy"
                      alt={product.name}
                      class="w-full h-full object-contain"
                    />
                  </button>
                </ScrollCard>

                {product.subImages.map((image) => (
                  <ScrollCard padding="p-1">
                    <button
                      data-src={urlFor(image).height(500).auto("format").url()}
                      data-srcset={[
                        `${urlFor(image).width(200).auto("format").url()} 200w`,
                        `${urlFor(image).width(400).auto("format").url()} 400w`,
                        `${urlFor(image).width(800).auto("format").url()} 800w`,
                        `${urlFor(image).width(1200).auto("format").url()} 1200w`,
                      ].join(", ")}
                      class:list={[
                        "thumb border-2 rounded-lg overflow-hidden w-32 h-32 flex-shrink-0 transition-colors",
                        "border-transparent transition-transform duration-300 hover:scale-105 hover:cursor-pointer shadow",
                      ]}
                    >
                      <img
                        src={urlFor(image).height(100).auto("format").url()}
                        srcset={[
                          `${urlFor(image).width(100).auto("format").url()} 100w`,
                          `${urlFor(image).width(200).auto("format").url()} 200w`,
                          `${urlFor(image).width(400).auto("format").url()} 400w`,
                        ].join(", ")}
                        sizes="auto"
                        loading="lazy"
                        alt={product.name}
                        class="w-full h-full object-contain"
                      />
                    </button>
                  </ScrollCard>
                ))}
              </HorizontalScroll>
            )
          }
        </div>

        <script>
          const mainImg = document.getElementById("main-img") as any;
          document
            .querySelectorAll<HTMLButtonElement>(".thumb")
            .forEach((btn) => {
              btn.addEventListener("click", () => {
                const src = btn.dataset.src!;
                const srcset = btn.dataset.srcset!;
                mainImg.src = src;
                mainImg.srcset = srcset;
                document.querySelectorAll(".thumb").forEach((t) => {
                  t.classList.remove("border-indigo-500");
                  t.classList.add("border-transparent");
                });
                btn.classList.remove("border-transparent");
                btn.classList.add("border-indigo-500");
              });
            });
        </script>
      </div>
    </div>
  </div>
</MainLayout>
