---
import "../styles/global.css";

import { sanityClient } from "sanity:client";
import Calendar from "../components/Calendar";
import { urlFor } from "../helper/imageUrlHelper";
import ArtProduct, { type HalfProduct } from "../components/ArtProduct.astro";
import type { PortableTextBlock } from "sanity";
import ImageRender from "../components/ImageRender.astro";
import type { SanityImageSource } from "@sanity/image-url";

import HorizontalScroll from "../components/HorizontalScroll.astro";
import ScrollCard from "../components/ScrollCard.astro";
import Description from "../components/Description.astro";
import MainLayout from "../layouts/MainLayout.astro";

import StoreCard, { type StoreType } from "../components/StoreCard.astro";

import EventManager from "../components/EventManager.astro";
import type { eventType } from "../components/EventCard.astro";

const FRONT_PAGE_QUERY = `*[
  _type == "frontPage"][0]{
    _id, 
    quote,
    message,
    main_image,
    section_name,
    highlights[]->{
      "name":IndividualProductName,
      slug,
      "mainImage":MainImage,
      "category":Category->{
        title
      },
      "theme":Theme->{
        title
      },
      "size":size
    },
    video_URL
    }`;

const front_page_info = await sanityClient.fetch<{
  _id: string;
  quote: string;
  message: PortableTextBlock;
  main_image: SanityImageSource;
  section_name: string;
  highlights: HalfProduct[];
  video_URL: string;
}>(FRONT_PAGE_QUERY);

const events = await sanityClient.fetch(`
  *[_type == "event"] {
    "title": EventName,
    "description": Description,
    "address": Address,
    "url": Stall,
    "image": Image,
    schedule[] {
      date,
      startTime,
      endTime
    }
  }
`);

const calendarEvents = events.flatMap((event: any) =>
  event.schedule.map((day: any) => ({
    title: event.title,
    start: `${day.date}T${day.startTime}`,
    end: `${day.date}T${day.endTime}`,
    extendedProps: {
      description: event.description,
      address: event.address,
      url: event.url,
      image: urlFor(event.image).url(),
    },
  })),
);

const cardEvents: eventType[] = await sanityClient.fetch(
  `
  *[_type == "event"]{
  "schedule": schedule[]{
    date,
    startTime,
    endTime,
    "eventId": ^._id,
    "eventName": ^.EventName,
    "slug": ^.slug,
    "image": ^.Image,
    "description": ^.Description,
    "stall": ^.Stall,
    "address": ^.Address
    }
  }.schedule[] | order(date asc)
  `,
);

const videoId: string = front_page_info.video_URL?.split("/").pop() || " ";
const quoteParts: string[] = front_page_info.quote.split("-");

const quoteLines: string[] = quoteParts[0].split("\n");

const STORE_QUERY = `
  *[_type == "store"] {
    "storeName": StoreName,
    slug,
    "storeImage": Image,
    "description":Description, 
    "address":Address,
    "url":URL,
    "productsSold":ProductsSold[]->{
      title,
      slug,
      image,
    }
  }
`;
const stores = await sanityClient.fetch<StoreType[]>(STORE_QUERY);
---

<MainLayout title="Handmade By Claire">
  <div class="bg-olive-200">
    <div>
      <div id="Main Image" class="relative w-full h-[95svh] overflow-hidden">
        <ImageRender
          alt="main image"
          image={front_page_info.main_image}
          style="w-full h-full object-cover object-center"
          width={2000}
        />

        <div
          class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-black/30"
        >
        </div>

        <div
          class="absolute bottom-0 left-0 right-0 flex flex-col items-center pb-12 text-white"
        >
          <h1 class="font-tempus text-7xl mb-2 text-center">
            Handmade By Claire
          </h1>
          <p
            class="text-lg mb-8 tracking-widest text-center uppercase opacity-80"
          >
            Original Textile Art
          </p>
          <a
            href="/works"
            class="border border-white text-white px-8 py-3
        tracking-widest uppercase text-sm hover:bg-white hover:text-black
        transition-colors duration-300"
          >
            Browse
          </a>
        </div>
      </div>
    </div>
    <div
      id="Highlights Section"
      class="w-full flex flex-col items-center pt-6 pb-6 content-center box-shadow-xl"
    >
      <h2
        class="text-5xl pt-8 text-center w-full font-tempus tracking-wide text-taupe-700"
      >
        {front_page_info.section_name}
        <div class="mx-auto mt-2 mb-1 w-60 h-[2px] bg-taupe-700 rounded-full">
        </div>
      </h2>
      <div class="w-full min-w-0 relative">
        <HorizontalScroll center={true}>
          {
            front_page_info.highlights.map((prod) => (
              <ScrollCard>
                <div>
                  <ArtProduct
                    mainImage={prod.mainImage}
                    name={prod.name}
                    slug={prod.slug}
                    theme={prod.theme}
                    category={prod.category}
                  />
                </div>
              </ScrollCard>
            ))
          }
        </HorizontalScroll>
      </div>
    </div>

    <div id="quote" class="relative h-[200vh]">
      <div class="sticky top-0 h-[100vh] overflow-hidden">
        <!-- Placeholder shown until video loads -->
        <div
          id="video-placeholder"
          class="absolute inset-0 bg-cover bg-center transition-opacity duration-1000 ease-in-out"
          style={`background-image: url(${urlFor(front_page_info.main_image).width(1600).url()})`}
        >
        </div>
        <!-- Video background -->
        <iframe
          id="quote-video"
          src={`https://player.vimeo.com/video/${videoId}?background=1&autoplay=1&loop=1&muted=1&autopause=0`}
          class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-0 transition-opacity duration-1000 ease-in-out"
          style="min-width: 177.77vh; min-height: 56.25vw; width: 100%; height: 100%;"
          allow="autoplay; fullscreen; picture-in-picture"></iframe>

        <div class="absolute inset-0 bg-black/50"></div>

        <div
          class="scroll-fade-out absolute inset-0 flex flex-col items-center justify-center text-white"
        >
          {
            quoteLines.map((line) => (
              <h1 class="p-2 text-l sm:text-2xl md:text-4xl font-bold">
                {line}
              </h1>
            ))
          }
          <p class="mt-5 text-md sm:text-xl md:text-3xl">-{quoteParts[1]}</p>
        </div>

        <!-- Message fades in after quote -->
        <div
          class="scroll-fade-in absolute inset-0 flex flex-col items-center justify-center text-white"
        >
          <div
            class="text-l sm:text-2xl md:text-3xl font-bold [&_p]:leading-loose [&_p]:mb-4 w-[60vw] text-center"
          >
            <Description description={front_page_info.message} />
          </div>
        </div>
      </div>
    </div>

    <div
      id="Events"
      class="w-full bg-taupe-100 flex flex-wrap justify-center items-center pl-4 pr-4 p-8 box-shadow-xl"
    >
      <h2
        class="text-6xl pt-8 text-center w-full font-tempus tracking-wide text-taupe-700"
      >
        Events
        <div class="mx-auto mt-2 mb-5 w-60 h-[2px] bg-taupe-700 rounded-full">
        </div>
      </h2>

      <div class="p-4">
        <h1 class="text-xl">Upcoming Events</h1>
        <div
          class="max-w-[90vw] lg:max-w-[50vw] relative border-solid pb-2 pt-2 border-gray-100"
        >
          <EventManager events={cardEvents} limit={2} />
        </div>
      </div>
      <div class="bg-white/80 w-[95vw] lg:w-md xl:w-lg rounded-lg shadow-md">
        <Calendar events={calendarEvents} client:visible />
      </div>
    </div>

    <div id="Stores" class="min-w-0 bg-[#b6d1db] pt-8">
      <h2
        class="text-6xl pt-8 text-center w-full font-tempus tracking-wide text-taupe-700"
      >
        Stores
        <div
          class="mx-auto mt-2 mb-5 w-60 pl-3 pr-3 h-[2px] bg-taupe-700 rounded-full"
        >
        </div>
      </h2>
      <div class="w-full min-w-0 relative">
        <HorizontalScroll center={true}>
          {
            stores.map((store) => (
              <ScrollCard>
                <StoreCard store={store} />
              </ScrollCard>
            ))
          }
        </HorizontalScroll>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  const hero = document.getElementById("quote");
  const fadeOut = document.querySelector(".scroll-fade-out") as HTMLElement;
  const fadeIn = document.querySelector(".scroll-fade-in") as HTMLElement;

  window.addEventListener("scroll", () => {
    if (!hero || !fadeOut || !fadeIn) return;

    const heroHeight = hero.getBoundingClientRect().height;
    const scrolled = window.scrollY - hero.offsetTop;
    const progress = scrolled / heroHeight;

    // Quote fades out between 0% and 15% scroll
    const outProgress = Math.max(0, Math.min((progress - 0.05) / 0.2, 1));
    fadeOut.style.opacity = String(1 - outProgress);
    fadeOut.style.transform = `translateY(${-40 * outProgress}px)`;

    // Message fades in between 15% and 30% scroll
    const inProgress = Math.max(0, Math.min((progress - 0.2) / 0.15, 1));
    fadeIn.style.opacity = String(inProgress);
    fadeIn.style.transform = `translateY(${40 * (1 - inProgress)}px)`;
  });

  const video = document.getElementById("quote-video") as HTMLIFrameElement;
  const placeholder = document.getElementById("video-placeholder");

  import Player from "@vimeo/player";

  const player = new Player(video);
  player.on("play", () => {
    video.style.setProperty("opacity", "1");
    placeholder?.style.setProperty("opacity", "0");
  });
</script>
