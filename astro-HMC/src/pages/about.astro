---
import { sanityClient } from "sanity:client";
import Description from "../components/Description.astro";
import ImageRender from "../components/ImageRender.astro";
import type { PortableTextBlock } from "sanity";
import type { SanityImageSource } from "@sanity/image-url";
import MainLayout from "../layouts/MainLayout.astro";
import HorizontalScroll from "../components/HorizontalScroll.astro";
import ScrollCard from "../components/ScrollCard.astro";
import { toPlainText } from "../helper/plainTextPortable";

const ABOUT_PAGE_QUERY = `*[
  _type == "aboutpage"][0]{
    _id, 
    about_image,
    about_me_description,
    studio_image,
    studio_description,
    event_history_description,
    event_images[]
    }`;

const about_page_info = await sanityClient.fetch<{
  _id: string;
  about_image: SanityImageSource;
  about_me_description: PortableTextBlock;
  studio_image: SanityImageSource;
  studio_description: PortableTextBlock;
  event_history_description: PortableTextBlock;
  event_images?: SanityImageSource[];
}>(ABOUT_PAGE_QUERY);
---

<MainLayout
  title="About"
  description={toPlainText(about_page_info.about_me_description)}
  image={about_page_info.about_image}
>
  <div class="bg-olive-200">
    <!-- About Me -->
    <div
      id="About"
      class="w-full flex flex-col items-center pt-6 pb-14 px-6 md:px-0"
    >
      <h2
        class="text-6xl pt-8 text-center w-full font-tempus tracking-wide text-taupe-700"
      >
        About Me
        <div class="mx-auto mt-2 mb-5 w-60 h-[2px] bg-taupe-700 rounded-full">
        </div>
      </h2>
      <div class="flex flex-col md:flex-row gap-8 max-w-5xl w-full h-full p-8">
        <div class="md:w-1/2 h-80 md:h-auto">
          <ImageRender
            alt="Picture of Claire"
            image={about_page_info.about_image}
            width={800}
            style="w-full h-full object-contain rounded-sm"
          />
        </div>
        <div
          class="md:w-1/2 text-lg text-taupe-800 [&_p]:leading-relaxed [&_p]:mb-4"
        >
          <Description description={about_page_info.about_me_description} />
        </div>
      </div>
    </div>

    <!-- Studio -->
    <div id="Studio Info" class="bg-stone-100 p-8">
      <h2
        class="text-6xl pt-8 text-center w-full font-tempus tracking-wide text-taupe-700"
      >
        Studio
        <div class="mx-auto mt-2 mb-5 w-60 h-[2px] bg-taupe-700 rounded-full">
        </div>
      </h2>
      <div class="flex flex-col md:flex-row max-w-5xl mx-auto gap-8 pb-6">
        <div class="md:w-1/2 h-80">
          <ImageRender
            alt="Studio Image"
            image={about_page_info.studio_image}
            width={800}
            style="w-full object-contain rounded-sm h-full"
          />
        </div>
        <div
          class="md:w-1/2 text-lg text-taupe-800 p-5 [&_p]:leading-relaxed [&_p]:mb-4"
        >
          <Description description={about_page_info.studio_description} />
        </div>
      </div>
    </div>

    <!-- Event History -->
    <div
      id="Event History"
      class="w-full flex flex-col items-center pt-6 pb-14 px-6 md:px-0"
    >
      <h2
        class="text-6xl pt-8 text-center w-full font-tempus tracking-wide text-taupe-700"
      >
        Event History
        <div class="mx-auto mt-2 mb-5 w-60 h-[2px] bg-taupe-700 rounded-full">
        </div>
      </h2>

      <div class="w-full min-w-0 relative">
        <div
          class="absolute left-0 top-0 bottom-0 w-12 bg-gradient-to-r from-olive-200 to-transparent z-10 pointer-events-none"
        >
        </div>
        <div
          class="absolute right-0 top-0 bottom-0 w-12 bg-gradient-to-l from-olive-200 to-transparent z-10 pointer-events-none"
        >
        </div>
        {
          about_page_info.event_images && (
            <HorizontalScroll center={true}>
              {about_page_info.event_images.map((img) => (
                <ScrollCard>
                  <div class="w-72 group">
                    <div class="overflow-hidden rounded-md shadow-md ">
                      <ImageRender
                        alt="event image"
                        image={img}
                        width={800}
                        style="w-full h-64 object-cover rounded-md"
                      />
                    </div>
                  </div>
                </ScrollCard>
              ))}
            </HorizontalScroll>
          )
        }
      </div>

      <div
        class="max-w-3xl w-full text-lg text-taupe-800 text-center [&_p]:leading-relaxed [&_p]:mb-4 mt-8"
      >
        <Description description={about_page_info.event_history_description} />
      </div>
    </div>
  </div>
</MainLayout>
