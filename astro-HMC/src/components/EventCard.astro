---
import ImageRender from "./ImageRender.astro";

const { image, name, theme, type, size, slug } = Astro.props;

export interface Props {
  title: string;
  eventImage: SanityImageSource;
  description: PortableTextBlock;
  schedule: {
    startTime: string;
    endTime: string;
    date: string;
  }[];
  address?: string;
  url?: string;
}

const { title, eventImage, description, schedule, address, url } = Astro.props;
---

<div class="bg-white rounded-md shadow-xl max-w-md w-full mx-4 overflow-hidden">
  {
    eventImage && (
      <ImageRender
        image={eventImage}
        alt={title}
        class:list="w-full h-48 object-cover"
      />
    )
  }

  <div class="p-6 space-y-4">
    <div class="flex items-start justify-between">
      <h2 class="text-xl font-bold text-gray-900">{title}</h2>
    </div>

    {
      schedule[0].startTime && (
        <div class="flex items-center gap-2 text-gray-600 text-sm">
          {/* <span>📅</span> */}
          <div>
            <div>{formatDate(schedule[0].startTime)}</div>
            {schedule[0].endTime && (
              <div>
                {formatTime(schedule[0].startTime)} –{" "}
                {formatTime(schedule[0].endTime)}
              </div>
            )}
          </div>
        </div>
      )
    }

    {
      address && (
        <div class="flex items-center gap-2 text-gray-600 text-sm">
          {/* <span>📍</span> */}
          <span>{address}</span>
        </div>
      )
    }

    {
      url && (
        <div class="flex items-center gap-2 text-gray-600 text-sm">
          {/* <span>🔗</span> */}
          <a href={url}>{url}</a>
        </div>
      )
    }

    {
      description && description.length > 0 && (
        <div class="text-gray-700 text-sm leading-relaxed border-t pt-4 prose prose-sm max-w-none">
          <description description={description} />
        </div>
      )
    }
  </div>
</div>
