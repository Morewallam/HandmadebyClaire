---
import type { SanityImageSource } from "@sanity/image-url";
import ImageRender from "./ImageRender.astro";
import type { PortableTextBlock } from "sanity";
import Description from "./Description.astro";

export interface Props {
  eventToDisplay: eventType;
}

export interface eventType {
  title: string;
  image: SanityImageSource;
  description: PortableTextBlock;
  startTime: string;
  endTime: string;
  date: string;
  address?: string;
  url?: string;
}

const {
  eventToDisplay: {
    title,
    image,
    description,
    startTime,
    endTime,
    date,
    address,
    url,
  },
} = Astro.props;

function formatDate(date: string, start: string) {
  const parsedDate = new Date(`${date}T${start}`);

  return parsedDate.toLocaleDateString();
}
function formatTime(time: string) {
  const date = new Date();
  const split = time.split(":");
  date.setHours(parseInt(split[0]));
  date.setMinutes(parseInt(split[1]));

  return date.toLocaleTimeString("en-US", { timeStyle: "short" });
}
---

<div
  class="bg-white shadow-xl max-w-2xs md:max-w-sm w-full mx-4 overflow-hidden"
>
  {
    image && (
      <ImageRender image={image} alt={title} style="w-full h-48 object-cover" />
    )
  }

  <div class="p-6">
    <div class="flex items-start justify-between">
      <h2 class="text-xl font-bold text-gray-900">{title}</h2>
    </div>

    {
      startTime && (
        <div class="flex items-center gap-2 text-gray-600 text-sm">
          <div>
            <div>{formatDate(date, startTime)}</div>
            {endTime && (
              <div>
                {formatTime(startTime)} – {formatTime(endTime)}
              </div>
            )}
          </div>
        </div>
      )
    }

    {
      address && (
        <div class="flex items-center gap-2 text-gray-600 text-sm">
          <span>{address}</span>
        </div>
      )
    }

    {
      url && (
        <div class="flex items-center gap-2 text-gray-600 text-sm">
          <a href={url}>{url}</a>
        </div>
      )
    }

    {
      description && (
        <div class="text-gray-700 text-sm leading-relaxed border-t pt-4 prose prose-sm max-w-none">
          <Description description={description} />
        </div>
      )
    }
  </div>
</div>
