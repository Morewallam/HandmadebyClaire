---
import "../styles/global.css";
import ImageRender from "./ImageRender.astro";

const { image, name, theme, type, size, slug } = Astro.props;
---

<a href={`/works/${slug.current}`} class="block">
  <div
    class="p-4 rounded-sm shadow-xs bg-stone-100 group transition-transform duration-300 hover:scale-110 h-80 md:h-120 w-40 sm:w-45 md:w-60"
  >
    <ImageRender
      image={image}
      width={500}
      style="aspect-rectangle w-full drop-shadow rounded-md object-contain h-40 md:h-80  group-hover:opacity-95 object-center"
    />
    <div class="mt-4 md:mt-4">
      <div class="mb-2">
        <h3 class="text-md md:text-xl text-gray-700">
          <span aria-hidden="true" class="inset-0"></span>
          <span>{name}</span>
        </h3>
        <p class="text-xs md:text-sm font-medium text-taupe-600">{theme}</p>
      </div>
      <p class="text-sm md:text-md font-medium text-taupe-700">{type}</p>
    </div>
  </div>
</a>
