---
import "../styles/global.css";
import { urlFor } from "../helper/imageUrlHelper";
import { type SanityImageSource } from "@sanity/image-url";
import { length } from "astro:schema";

export interface Props {
  image: SanityImageSource;
  width?: number;
  height?: number;
  style?: string;
  alt: string;
  lazy?: boolean;
  fetch_priority?: "auto" | "high";
}

const {
  image,
  width,
  height,
  style,
  alt,
  lazy = true,
  fetch_priority = "auto",
} = Astro.props;

let imgUrl = urlFor(image).auto("format");
let baseUrl = imgUrl;
if (width) {
  baseUrl = baseUrl.width(width);
}

if (height) {
  baseUrl = baseUrl.height(height);
}

const load = lazy ? "lazy" : "eager";
---

<img
  src={baseUrl.url()}
  loading={load}
  srcset={[
    `${imgUrl.width(200).url()} 200w`,
    `${imgUrl.width(400).url()} 400w`,
    `${imgUrl.width(800).url()} 800w`,
    `${imgUrl.width(1200).url()} 1200w`,
    `${imgUrl.width(1500).url()} 1500w`,
    `${imgUrl.width(2000).url()} 2000w`,
    `${imgUrl.width(2500).url()} 2500w`,
  ].join(", ")}
  alt={alt}
  sizes="auto"
  fetchpriority={fetch_priority}
  class={style}
/>
