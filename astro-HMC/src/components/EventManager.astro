---
import EventCard, { type eventType } from "./EventCard.astro";

export interface Props {
  events: eventType[];
  limit?: number;
}

const { events, limit = 2 } = Astro.props;
---

<event-manager data-events={JSON.stringify(events)} data-limit={limit}>
  <div class="grid grid-cols-1 sm:grid-cols-2">
    {
      events.map((evt, i: number) => (
        <div id={"eventcard" + String(i)} class="oldcard p-2">
          <EventCard eventToDisplay={evt} />
        </div>
      ))
    }
  </div>
</event-manager>

<style>
  .oldcard {
    display: none;
  }
</style>

<script>
  import type { eventType } from "./EventCard.astro";

  class EventManger extends HTMLElement {
    connectedCallback() {
      const events: eventType[] = JSON.parse(this.dataset.events ?? "[]");

      let limit = Number(this.dataset.limit ?? 3);

      const date = new Date();
      date.setHours(0, 0, 0, 0);

      events.map((evt, i) => {
        let eventelm = document.getElementById("eventcard" + String(i));
        const dateValues = evt.date.split("-");
        const evtDate = new Date();
        evtDate.setFullYear(
          parseInt(dateValues[0]),
          parseInt(dateValues[1]) - 1,
          parseInt(dateValues[2]),
        );
        evtDate.setHours(0, 0, 0, 0);

        if (evtDate.valueOf() - date.valueOf() >= 0 && limit > 0) {
          eventelm?.classList.remove("oldcard");
          limit = limit - 1;
        }
      });
    }
  }

  customElements.define("event-manager", EventManger);
</script>
